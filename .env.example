NODE_ENV=development

# Database
DB_DATABASE=kdp_generator
DB_USERNAME=kdp_user
DB_PASSWORD=kdp_password

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here

# AI Cover Generation Pipeline
# Replicate: used to AI-upscale generated cover art to 300 DPI print resolution
REPLICATE_API_TOKEN=r8_your-api-token-here
# Stability AI: optional alternative to OpenAI/DALL-E for cover art generation
STABILITY_API_KEY=sk-your-stability-key-here

# API Server
API_PORT=3000
